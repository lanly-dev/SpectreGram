{
    "name": "spectregram",
    "description": "SpectreGram — acoustic spectrum analyser and lossy-disguise verdict (Kiroween 2026 Resurrection). Desktop app (Electron) + web demo, same code.",
    "private": true,
    "main": "electron/main.js",
    "build": {
        "appId": "dev.lanly.spectregram",
        "productName": "SpectreGram",
        "icon": "build/icon.png",
        "directories": {
            "output": "release"
        },
        "fileAssociations": [
            {
                "ext": "mp3",
                "name": "MP3 audio",
                "role": "Viewer"
            },
            {
                "ext": "flac",
                "name": "FLAC audio",
                "role": "Viewer"
            },
            {
                "ext": "wav",
                "name": "WAV audio",
                "role": "Viewer"
            },
            {
                "ext": "ogg",
                "name": "Ogg audio",
                "role": "Viewer"
            },
            {
                "ext": "m4a",
                "name": "M4A audio",
                "role": "Viewer"
            },
            {
                "ext": "opus",
                "name": "Opus audio",
                "role": "Viewer"
            },
            {
                "ext": "aac",
                "name": "AAC audio",
                "role": "Viewer"
            },
            {
                "ext": "wma",
                "name": "WMA audio",
                "role": "Viewer"
            }
        ],
        "files": [
            "dist/**",
            "electron/**",
            "package.json"
        ],
        "linux": {
            "target": "AppImage"
        },
        "mac": {
            "target": "dmg"
        },
        "win": {
            "target": "nsis"
        }
    },
    "dependencies": {
        "fft.js": "4.0.4"
    },
    "devDependencies": {
        "electron": "45.2.3",
        "electron-builder": "26.18.0",
        "typescript": "7.0.2",
        "vite": "8.3.6",
        "vitest": "5.1.0"
    },
    "scripts": {
        "start": "npm run build && electron .",
        "dev": "node scripts/electron-dev.mjs",
        "build": "tsc --noEmit && vite build",
        "preview": "npm run dev",
        "dist": "npm run build && electron-builder",
        "pack": "npm run build && electron-builder --dir",
        "web:dev": "vite",
        "web:preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "type": "module",
    "version": "0.1.0"
}
